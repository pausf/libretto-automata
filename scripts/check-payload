check_wiring skills/converge/SKILL.md 'uncovered means the change.s own criteria' 'converge counts only the change'"'"'s own criteria as uncovered'
check_wiring skills/converge/SKILL.md 'appended after the checklist.s last box' 'an uncovered criterion whose proof fails gets a box after the last one'
check_wiring skills/converge/SKILL.md '\(converge <date>\)'              'an appended box is marked (converge <date>)'
check_wiring skills/converge/SKILL.md 'passes already, so no box is appended' 'an uncovered criterion whose proof passes gets no box'

printf '\n── skills never point at an executable that is not installed ──\n'
# `libretto install` links skills/, agents/ and commands/ — nothing else. A SKILL.md
# telling the user to run scripts/foo is broken for everyone who installed it:
# scripts/ never reaches their machine, so it only ever worked in the repo it came
# from. A tool a skill needs ships inside the skill's own directory.
#
# Scoped to executables on purpose. Prose mentioning docs/ or an example
# internal/foo_test.go path is describing, not instructing, and failing those
# turns this check into noise nobody reads.
unreachable=$(rg -oN '(^|[^A-Za-z0-9._/~-])(scripts|bin)/[A-Za-z0-9._-]+' skills/*/*.md 2>/dev/null || true)
if [ -n "$unreachable" ]; then
  printf '%s\n' "$unreachable" | while IFS= read -r hit; do
    fail "not installed, so unreachable for users: $hit"
  done
  fails=$((fails + 1))
else
  ok 'no skill invokes an uninstalled path'
fi

printf '\n── skills never hardcode the install layout ──\n'
# A skill naming its tools by an absolute install path works only in the layout it
# was written in. install --project puts the payload under <project>/.claude, and
# the skill breaks for exactly the users who chose that. Tools are referenced
# relative to the skill's own base directory, which every invocation announces.
layout=$(rg -n '~/\.claude/' skills/ 2>/dev/null || true)
if [ -n "$layout" ]; then
  while IFS= read -r hit; do
    fail "absolute install path: $hit"
  done <<< "$layout"
else
  ok 'no ~/.claude/ absolute paths in skills/'
fi

printf '\n── referenced paths exist ──\n'
# docs/specs/ and docs/superpowers/ are conventions for the *target* project, not
# paths in this repository. Everything else referenced here must exist here.
# Prose only. Scripts carry fixture paths that are deliberately fictional — a
# test asserting "docs/README.md is not inside src/**" must not be read as a
# claim that docs/README.md exists.
# -I, because without it the first rg prefixes each hit with its filename and the second
# rg re-extracts from that prefix: `docs/PAYLOAD.md:scripts/check-payload` yielded both
# strings, so any file living under docs/ or scripts/ verified itself as a referenced path.
# docs/PAYLOAD.md and docs/PLAN.md were both being reported ok while nothing referenced
# them. Noise rather than a false pass — a genuine reference is a text match either way —
# but a check that reports paths nobody cites is a check whose output stops being read.
paths=$(rg -oNI -g '*.md' '(docs|scripts)/[A-Za-z0-9._-]+' skills commands docs *.md 2>/dev/null \
          | rg -oN '(docs|scripts)/[A-Za-z0-9._-]+' \
          | rg -v '^docs/(specs|superpowers)' | sort -u)
while IFS= read -r p; do
  [ -z "$p" ] && continue
  [ -e "$p" ] && ok "$p" || fail "referenced path does not exist: $p"
done <<< "$paths"

printf '\n── prose addresses the agent, never Claude by name ──\n'
# Skills install into Codex and OpenCode too, and "ask Claude" read there is an
# instruction about somebody else. The classification lives entirely in this
# allowlist — factual uses: env var, file names, real paths, and the product name
# "Claude Code" in a sentence about Claude Code. Anything else is an addressee
# and fails. The check exercises no judgment, so it cannot drift.
# Occurrence-level, not line-level: allowlisted tokens are deleted from each
# hit first, so a bare Claude sharing a line with "Claude Code" still fails.
addressee=$(rg -nN '\bClaude\b' skills commands -g '*.md' 2>/dev/null \
              | sed -E 's/CLAUDE_HOME|CLAUDE\.md|~\/\.claude|\.claude\///g; s/Claude Code//g' \
              | rg '\bClaude\b' || true)
if [ -z "$addressee" ]; then
  ok 'no bare Claude in payload prose'
else
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    fail "prose addresses Claude where it means the agent: $hit"
  done <<< "$addressee"
fi

printf '\n── a Claude-only mechanism names the host-neutral capability ──\n'
# The payload keeps Claude Code's tool names — that is the contract, not an oversight.
# What it owes alongside is the capability, so a model on Codex or OpenCode reaches for
# its own equivalent instead of a tool it does not have.
#
# The classification is a marker lookup and exercises no judgment, exactly like the
# addressee check above: `native prompt` for a mandate to ask, `host's own` for a mandate
# to load a skill. Two alternatives because the four skills that already comply all carry
# the first and none carries anything else — a single new marker would fail the files that
# got it right.
#
# File-level, and newlines squashed before searching. Both matter: the marker phrase wraps
# across line breaks in prose this width, and a line-scoped search reported a compliant
# file as broken while this check was being written.
#
# agents/ is excluded on purpose. Agents install into Claude alone, so there is no second
# host for their prose to be wrong for. That changes when they gain one.
missing=''
for f in $(rg -l 'AskUserQuestion|Skill\(skill=' skills commands -g '*.md' 2>/dev/null); do
  tr '\n' ' ' < "$f" | rg "native +prompt|host's +own" >/dev/null || missing="$missing$f"$'\n'
done
if [ -z "$missing" ]; then
  ok 'every Claude-only mandate names the capability beside it'
else
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    fail "mandates a Claude-only tool and names no host-neutral capability: $m"
  done <<< "$missing"
fi

printf '\n'
if [ "$fails" -eq 0 ]; then
  printf 'check-payload: all checks passed\n\n'; exit 0
fi
printf 'check-payload: %d failure(s)\n\n' "$fails"; exit 1
