#!/usr/bin/env bash
# check-payload — static checks on the skills, commands and their cross-references.
#
# Catches what silently degrades a prompt: a skill referenced by a name that does
# not exist, a path that moved, frontmatter a host cannot parse, a stray file that
# the linker would install as if it were an item.
#
# Behaviour is not checked here. A prompt's behaviour is checked by running it.
#
# Exit 1 on any failure, so this can gate a commit if someone wants it to.

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

fails=0
fail() { printf '  FAIL  %s\n' "$*"; fails=$((fails + 1)); }
ok()   { printf '  ok    %s\n' "$*"; }

# ── the payload index ────────────────────────────────────────────────────────
# Every skill, agent and command that ships, and until now no page listed them. A page
# listing them by hand is the failure this repository has already paid for twice: a
# paragraph in AGENTS.md said "ten" over eleven spec directories, which is why
# docs/SPEC.md is the only place the capability list lives.
#
# No count is written in this comment either. The first version of it said "22 skills,
# 7 agents and 7 commands" — a typed count sitting next to a generator whose stated
# reason for existing is that a typed count drifted. Found by the 6→7 reviewer.
#
# So the page is generated from the same frontmatter parse the checks below use, and
# the default run fails when the committed page has drifted. One parse, so a page and
# a gate cannot disagree about what an item is called.
#
# --index writes. The default run only compares: a gate that repairs what it measures
# is a gate that can never fail.
payload_index() {
  printf '# The payload\n\n'
  printf '**Generated by `scripts/check-payload --index`. Do not edit by hand** — the payload\n'
  printf 'gate fails when this page has drifted, and a hand edit is lost on the next run.\n\n'
  printf 'What `libretto install` puts into a target, and nothing else. Mostly by symlink; an\n'
  printf 'OpenCode agent is a derived file this tool writes, and Codex takes skills only — so\n'
  printf 'which of these reach a given target depends on the target.\n\n'
  printf '`scripts/` and `docs/` are not installed, so no skill, agent or command may reference\n'
  printf 'this page.\n\n'
  printf 'The eight phases and why they are those is [FLOW.md](FLOW.md); the capability\n'
  printf 'specification is [SPEC.md](SPEC.md). This page is only what ships.\n'

  index_group 'Skills' skills/*/SKILL.md
  index_group 'Agents' agents/*.md
  index_group 'Commands' commands/*.md
}

# A description is one line for most items and a folded YAML scalar for four of them —
# caveman, caveman-commit, ponytail and ponytail-debt all write `description: >` with the
# text on following indented lines. The first version of this took the value after the
# colon and printed a literal `>` for those four: outcome 1 unmet for four of thirty-six
# rows with the gate green, because the gate and the generator share this parse and so
# agreed with each other about nothing. Found by the 6→7 reviewer.
#
# Deliberately not a YAML parser. payload already records that a dependency added to check
# a document is a dependency added to check a checker; this reads the two block forms that
# exist here — `>` and `|`, with or without a chomping indicator — and nothing else.
item_description() {
  awk '
    /^description:[[:space:]]*[>|][+-]?[[:space:]]*$/ { folding = 1; next }
    folding {
      if ($0 ~ /^[[:space:]]/ && NF) { $1 = $1; out = out (out ? " " : "") $0; next }
      if (NF == 0) next
      exit
    }
    /^description:/ { sub(/^description:[[:space:]]*/, ""); print; exit }
    END { if (folding) print out }
  ' "$1" | tr -d '"\r'
}

# One row per item: its name off disk, and its own description. Sorted, never in flow
# order — an order maintained by hand is the drift this page exists to avoid.
#
# LC_ALL=C on the sort, so the page a contributor generates is the page CI compares
# against. Collation is locale-dependent: glibc ignores punctuation at the first level and
# would order `caveman` before `caveman-commit`, while byte order puts the hyphen first —
# so without this the gate reports drift on a page nobody edited, on a different machine.
# The reviewer that found this could not observe GNU sort here and said so rather than
# concluding; pinning the collation settles it either way.
index_group() {
  local heading=$1; shift
  printf '\n## %s\n\n| | |\n|---|---|\n' "$heading"
  for f in "$@"; do
    [ -f "$f" ] || continue
    local n
    case "$f" in
      */SKILL.md) n=$(basename "$(dirname "$f")") ;;
      *)          n=$(basename "$f" .md) ;;
    esac
    printf '| `%s` | %s |\n' "$n" "$(item_description "$f")"
  done | LC_ALL=C sort
}

if [ "${1:-}" = '--index' ]; then
  payload_index > docs/PAYLOAD.md
  printf 'check-payload: wrote docs/PAYLOAD.md\n'
  exit 0
fi

printf '\n── the payload index is current ──\n'
# Compared through a variable on both sides, so a trailing-newline difference between
# what was written and what is read cannot fail a page the generator just produced.
if [ ! -f docs/PAYLOAD.md ]; then
  fail 'docs/PAYLOAD.md does not exist — run scripts/check-payload --index'
elif [ "$(payload_index)" != "$(cat docs/PAYLOAD.md)" ]; then
  fail 'docs/PAYLOAD.md has drifted from the payload — run scripts/check-payload --index'
else
  ok 'docs/PAYLOAD.md matches what ships'
fi

printf '\n── skills ──\n'
for d in skills/*/; do
  n=$(basename "$d")
  f="$d/SKILL.md"
  [ -f "$f" ] || { fail "$n has no SKILL.md"; continue; }

  # Frontmatter must open on line 1 and close.
  [ "$(head -1 "$f")" = '---' ] || { fail "$n frontmatter does not start on line 1"; continue; }
  awk 'NR>1 && /^---$/{found=1; exit} END{exit !found}' "$f" \
    || { fail "$n frontmatter is not closed"; continue; }

  name=$(rg -N -m1 '^name:' "$f" | sed 's/^name:[[:space:]]*//' | tr -d '"')
  desc=$(rg -N -m1 '^description:' "$f")

  [ -n "$name" ]        || fail "$n has no name:"
  [ -n "$desc" ]        || fail "$n has no description:"
  [ "$name" = "$n" ]    || fail "$n declares name: $name — must match its directory"
  [ -n "$name" ] && [ -n "$desc" ] && [ "$name" = "$n" ] && ok "$n"
done

printf '\n── stray files the linker would install ──\n'
stray=$(find skills agents commands -maxdepth 1 -type f ! -name '*.md' ! -name '.gitkeep' 2>/dev/null)
if [ -n "$stray" ]; then
  printf '%s\n' "$stray" | while IFS= read -r s; do fail "stray: $s"; done
  fails=$((fails + 1))
else
  ok 'none'
fi

printf '\n── agents ──\n'
# An agent's name: is what the Agent tool is called with. If it does not match the
# filename, the caller reads one thing off disk and invokes another, and the failure
# is a subagent that silently never runs.
found_agent=
for f in agents/*.md; do
  [ -f "$f" ] || continue
  found_agent=1
  b=$(basename "$f" .md)

  [ "$(head -1 "$f")" = '---' ] || { fail "$b frontmatter does not start on line 1"; continue; }
  awk 'NR>1 && /^---$/{found=1; exit} END{exit !found}' "$f" \
    || { fail "$b frontmatter is not closed"; continue; }

  name=$(rg -N -m1 '^name:' "$f" | sed 's/^name:[[:space:]]*//' | tr -d '"')
  desc=$(rg -N -m1 '^description:' "$f")

  [ -n "$name" ]     || fail "$b has no name:"
  [ -n "$desc" ]     || fail "$b has no description:"
  [ "$name" = "$b" ] || fail "$b declares name: $name — must match its filename"
  [ -n "$name" ] && [ -n "$desc" ] && [ "$name" = "$b" ] && ok "$b"
done
[ -n "$found_agent" ] || ok 'none'

printf '\n── commands ──\n'
for f in commands/*.md; do
  [ -f "$f" ] || continue
  [ "$(head -1 "$f")" = '---' ] && rg -qN '^description:' "$f" \
    && ok "$(basename "$f")" || fail "$(basename "$f") missing frontmatter description"
done

printf '\n── referenced skills resolve ──\n'
# Only scan skills/ and commands/. docs/SPEC.md and docs/PLAN.md use skill names
# as fixtures in symlink scenarios ("skills/po-assistant/") and those are
# illustrations, not references — scanning them reports invented names as broken.
refs=$( { rg -oN 'Skill\(skill="[a-z0-9-]+"\)' skills commands 2>/dev/null \
            | rg -oN '"[a-z0-9-]+"' | tr -d '"'
          rg -oN 'skills/[a-z0-9-]+/' skills commands 2>/dev/null \
            | rg -oN 'skills/[a-z0-9-]+' | sed 's|skills/||'
        } | sort -u )
if [ -z "$refs" ]; then
  fail 'no skill references found — the grep is probably wrong'
else
  while IFS= read -r r; do
    [ -d "skills/$r" ] && ok "$r" || fail "referenced skill does not exist: $r"
  done <<< "$refs"
fi

printf '\n── namespaced refs the payload does not ship are overridden ──\n'
# A `plugin:skill` reference names something installed under a namespace this payload
# has no control over. The vendored skills carry three of them, and a user who installed
# only this repository has none — so the plan they generate opens by demanding a skill
# that does not exist, and the flow stalls on its own first line. That shipped for
# months without anybody noticing, because nothing read the namespace.
#
# The vendored copies stay byte-comparable with upstream (THIRD-PARTY.md), so the fix is
# never an edit to them: the Libretto skill that delegates to one states the override.
# So this only reads refs inside vendored skills, and requires each to be answered by a
# skill that is not vendored. A ref inside a Libretto skill IS the answer, never the fault.
# The namespace is not hardcoded. `superpowers:` was, and four of the seven vendored
# skills come from two other upstreams — so a `obra:phantom-skill` in writing-plans passed
# silently. Any `namespace:skill-name` token counts. Measured across all seven vendored
# directories, that pattern finds exactly the four real refs and no prose: `Trigger: x`
# and friends have a space after the colon and cannot match.
vendored_refs() {
  rg -oNI --no-heading '\b[a-z][a-z0-9-]*:[a-z][a-z0-9-]*' "$1" -g '*.md' 2>/dev/null | sort -u
}

vendored=$(rg -oN '^\| `skills/[a-z0-9-]+/`' THIRD-PARTY.md | rg -oN 'skills/[a-z0-9-]+' | sort -u)
if [ -z "$vendored" ]; then
  fail 'no vendored skills read from THIRD-PARTY.md — the grep is probably wrong'
fi
# The answer has to come from a Libretto skill, so every vendored directory is excluded
# from the search and not merely the one citing the ref. Excluding only the citing
# directory let one vendored skill answer for another: `superpowers:ghost-skill` added to
# both writing-plans/ and ponytail/ passed, each counting as the other's override.
libretto_skills=$(printf '%s\n' skills/*/SKILL.md)
for v in $vendored; do
  libretto_skills=$(printf '%s\n' "$libretto_skills" | rg -v "^$v/" || true)
done
[ -n "$libretto_skills" ] || fail 'every skill reads as vendored — the THIRD-PARTY.md parse is wrong'

ns_fails=0
ns_seen=
for v in $vendored; do
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    bare=${hit##*:}
    if [ -d "skills/$bare" ]; then
      ok "$hit — payload ships $bare"
    # shellcheck disable=SC2086  # the file list is newline-separated on purpose
    elif [ -n "$libretto_skills" ] && rg -qN "$hit" $libretto_skills 2>/dev/null; then
      ok "$hit — not shipped, answered by a Libretto skill"
    else
      fail "vendored ref the payload does not ship and no skill answers: $v cites $hit"
      ns_fails=1
    fi
  done <<< "$(vendored_refs "$v")"
  ns_seen=1
done
[ -n "$ns_seen" ] || ok 'no vendored skills to check'
# No `fails` bump here: `fail` already counted each one. The herestring loop above runs in
# this shell, not a subshell, so its increments survive — unlike the stray-files block,
# which pipes into `while` and does need the manual bump. Copying that line here inflated
# the summary count without changing the exit code, which is the kind of wrong number a
# checker should not be the source of.

printf '\n── the wiring a criterion claims exists ──\n'
# A payload criterion about prompt *behaviour* cannot be machine-checked, and citing this
# script for one is a citation that reads as proven and can never fail. Review caught three
# of those: deleting every review-spec line from the flow and every bug branch from
# write-spec and find-work left this script green.
#
# What IS checkable is the wiring — that the phase exists, is reachable from the command
# that routes to it, and that the branch's decisive words are still in the file that owns
# them. That is not proof the prompt behaves; it is proof the prompt is still there to.
# Each row: <file> <pattern> <what the criterion promises>
check_wiring() {  # <file> <pattern> <description>
  if rg -qN -- "$2" "$1" 2>/dev/null; then ok "$3"
  else fail "$3 — $1 no longer contains /$2/"; fi
}
# The inverse. Two of this change's criteria are about what must NOT be in the command
# that describes no phase, and a presence check cannot express either.
check_absent() {  # <file> <pattern> <description>
  if rg -qN -- "$2" "$1" 2>/dev/null; then fail "$3 — $1 still contains /$2/"; else ok "$3"; fi
}
check_wiring commands/libretto-flow.md   'Skill\(skill="review-spec"\)' 'the flow routes to review-spec'
check_wiring commands/libretto-attacca.md 'Skill\(skill="review-spec"\)' 'attacca routes to review-spec too'
check_wiring commands/libretto-flow.md   'before the stop, not after'   'review-spec runs before the contract stop'
check_wiring skills/review-spec/SKILL.md 'never rewrites the spec'      'review-spec reports and does not rewrite'
check_wiring skills/write-spec/SKILL.md  'the work is a bug'       'write-spec carries the bug branch'
check_wiring skills/write-spec/SKILL.md  'fails right now'              'the bug branch demands a red test first'
check_wiring skills/find-work/SKILL.md   'whether it is a bug'          'phase 1 names bug-or-not'
check_wiring skills/find-work/SKILL.md   'dispatched by a branch'       'the queue scan drops a proposal its branch already took'
check_wiring skills/find-work/SKILL.md   'a box under its .## Checklist. is not queued' 'the queue scan drops a proposal whose checklist holds a box'
check_wiring skills/find-work/SKILL.md   'same .Queued:. date go by change name, ascending' 'the queue breaks a date tie by change name'
check_wiring skills/find-work/SKILL.md   '.libretto queue. implements this section; where the two disagree, the section is the rule' 'the queue section names the binary as its implementation, and wins'
check_absent commands/libretto-status.md 'libretto queue'               '/libretto-status never calls the binary for the queue'
check_absent commands/libretto-next.md   'libretto queue'               '/libretto-next never calls the binary for the queue'
check_wiring skills/write-spec/SKILL.md  'never the corpus'             'phase 2 selects the governing spec, not the spec root'
check_wiring skills/write-spec/SKILL.md  'proposal\.md.*always the vocabulary' 'a fan-out writer is given proposal.md by path, its vocabulary always'
check_wiring skills/write-spec/SKILL.md  'rebills the whole context'    'the fan-out of spec-<capability>.md writers states what a mid-phase model switch costs'
check_wiring skills/record-work/drift.md 'opt-in and stays' 'the block hook snippet is documented as opt-in'
check_wiring skills/record-work/drift.md '^\| \*\*joined criterion\*\* \|' 'record-work carries joined criteria as a row of its --trace table'
check_wiring skills/review-spec/SKILL.md 'split the criterion or name its ceiling' 'review-spec reads joined criteria as a prompt to split or name a ceiling'
check_wiring skills/build-and-check/SKILL.md 'judging the change means looking' 'phase 6 renders and looks at visual output'
check_wiring skills/review-work/SKILL.md 'the phase field exactly .6→7.' 'the seam ledgers each finding as 6→7'
check_wiring skills/write-spec/SKILL.md 'no hard cap, and the bias is toward asking' 'phase 2 questions are judgment, biased to ask'
check_wiring skills/write-spec/SKILL.md 'never a form-length interrogation' 'the judgment rule keeps its upper edge'
check_wiring skills/write-spec/SKILL.md  '## Decision log'              'phase 2 defines the decision log as a section of proposal.md, verbatim and dated'
check_wiring skills/write-spec/SKILL.md  'one question per .AskUserQuestion. call' 'phase 2 interviews: one at a time, recommendation reasoned, no-more always offered'
check_wiring skills/write-spec/SKILL.md  'NEEDS CLARIFICATION'          'the orchestrator resolves markers: ask, log, patch the bracket expression only'
check_wiring agents/spec-writer.md       'NEEDS CLARIFICATION'          'the writer marks what its inputs left open, never guesses past it'
check_wiring skills/write-plan/SKILL.md  'two or three approaches'      'phase 5 forks: the user chooses the approach from named tradeoffs'
check_wiring skills/write-plan/SKILL.md  '## Decision log'              'the fork logs chosen and rejected, with why, verbatim'
check_wiring commands/libretto-attacca.md '## Decision log'             'attacca logs every assumed answer in the change document'
# The two stops, as the payload spec's own ceiling names the check: the string search
# across stop-owning skills. Presence of each stop's native question is checkable; that
# no third stop exists is not — a script cannot tell a prompt from a paragraph. What is
# checkable is that the two retired stops did not survive beside their replacement, so
# those are absence rows written against the skills' own wording.
check_wiring skills/review-spec/SKILL.md  'AskUserQuestion'             'stop 1 — the whole change document, before code — is asked natively'
check_absent skills/write-spec/SKILL.md   'wait for the go-ahead'       'phase 2 no longer stops for the contract on its own'
check_absent skills/write-tasks/SKILL.md  'Ask for the go-ahead'        'the 5→6 seam no longer stops for the order on its own'
check_wiring skills/record-work/SKILL.md  'AskUserQuestion'             'stop 2 — the push — is asked natively'
check_wiring skills/evidence/SKILL.md    'lessons\.md'                  'evidence captures corrections into the ledger'
check_wiring skills/evidence/SKILL.md    'Said:'                        'the capture keeps the user words, not a paraphrase'
check_wiring skills/retro/SKILL.md       'Resolved:'                    'retro spends entries by marking, never editing'
check_wiring skills/retro/SKILL.md       'Never apply it'               'retro proposes payload diffs and never applies'
check_wiring commands/libretto-retro.md  'Skill\(skill="retro"\)'       'libretto-retro routes to the retro skill'
check_wiring skills/record-work/forge.md 'the bump is asked once' 'attacca asks the bump at the end'
check_wiring skills/record-work/forge.md 'read the request back'  'the applied label is read back off the request'
check_wiring skills/record-work/forge.md 'never the first option' 'release:major is never recommended'
check_wiring skills/record-work/forge.md 'defines none of the three' 'a repository without the labels is not asked'
check_wiring skills/record-work/forge.md 'is never withdrawn' 'the red-check line survives an unanswered question'
check_wiring skills/record-work/forge.md 'the bump a person chose' 'the request records who chose the bump'
# The four below came from the phase 6→7 reviewer. Each guards a defect that shipped
# green: a detection that inverts silently, a promise with no step behind it, a prefix
# match, and the same file forbidding absolutely what it two paragraphs later permits.
check_wiring skills/record-work/forge.md 'Never a bare .gh label list.' 'label detection is searched and bounded, never the default 30'
check_wiring skills/record-work/forge.md 'Never a prefix or a substring' 'labels are matched by whole name'
check_wiring skills/record-work/forge.md 'this step is not optional' 'the chosen bump is written back into the description'
check_wiring skills/record-work/forge.md 'label the user did not choose' 'the push consent does not extend to a label'
# Line-scoped, like every row above: the phrase has to sit on one line in the skill. It
# proves the mandate is present and nothing about whether a plan obeyed it — that is
# judgment, and it belongs to phase 6 and the 6→7 reviewer.
check_wiring skills/write-tasks/SKILL.md 'one badly cut box' 'a box is cut to stand alone, and two dependent boxes are one'
# The checklist moved out of write-plan on 2026-08-17 and this row moved with it. Both
# halves are checked, because the failure the split invites is a plan that keeps the
# checkbox vocabulary: phase 5 writing state again is the drift back to what was reported.
check_wiring skills/write-plan/SKILL.md 'No checkboxes.' 'the plan holds the approach and never the state'
check_wiring skills/write-plan/SKILL.md 'Why it lost' 'the plan records the alternatives the approach beat'
# Phase 1 ran over this exact state and said nothing: two changes with every box closed,
# their folders still present, their landing unfinished. The signal was already in the two
# rg scans it runs — rg -c is silent for a file that did not match — and no sentence said
# what the difference between them meant. One phrase, both files, because a row per wording
# is two things to keep in step.
check_wiring skills/find-work/SKILL.md 'finished and not landed' 'phase 1 names a change whose boxes are all closed and whose folder is still there'
check_wiring commands/libretto-status.md 'finished and not landed' 'status reports a finished change that never landed, separately from work in flight'
# The 6→7 reviewer found this one missing: the change added three mandates and wired two.
# The unwired one settled which document a retirement reads, after the tree was already
# holding the contradiction it exists to prevent.
check_wiring skills/write-plan/SKILL.md 'never the list' 'the Durable decisions line is a claim about whether the list is empty, not the list, in whichever document carries it'

# The pattern is the command's own wording, not the payload spec's. The plan named the
# spec's phrase — which the command never contained — so the row was green the moment it
# was written and proved nothing. The red step is what caught it.
check_absent commands/libretto-attacca.md 'or put a .release:. label on the request' 'the command no longer forbids labelling outright'
check_absent commands/libretto-attacca.md 'gh pr edit'               'the command does not restate phase 8'
check_wiring commands/libretto-attacca.md 'a bump the user did not choose' 'labelling is forbidden only when unchosen'

# Two layouts, one box rule. A bare `- [ ]` count over the whole file is not the CLI's
# definition: it counts fenced boxes, and in proposal.md every box outside `## Checklist`.
# The absent rows are the old scan and the old trivial-lane sentence, so neither comes back
# beside its replacement.
check_wiring skills/find-work/SKILL.md '\^\\s\*\[-\*\]\\s\+\\\[\( \|x\|X\)\\\]' 'phase 1 states the CLI box definition'
check_wiring skills/find-work/SKILL.md 'is the checklist when its .## Checklist. holds a box' 'phase 1 picks proposal.md, then tasks.md, then plan.md'
check_wiring skills/find-work/SKILL.md 'for f in proposal\.md tasks\.md plan\.md' 'both scans read the three files in that order'
check_absent skills/find-work/SKILL.md "rg -c '\^\\\\s\*- " 'the bare whole-file box count is gone'
check_absent skills/find-work/SKILL.md 'needed no spec never creates'  'phase 1 no longer claims the trivial lane leaves no change folder'
check_wiring skills/write-spec/SKILL.md 'in the trivial lane.s own commit' 'the trivial lane deletes its phase-1 capture'
check_absent skills/write-spec/SKILL.md 'Six pillars, a brief and a plan' 'step 0 names no brief or plan the flow no longer writes'
# The method borrows an idea and none of a name: what installs speaks Libretto's own vocabulary.
# Case-sensitive on the acronym, so the ordinary word "odd" stays free to be used.
for d in skills agents commands; do
  if rg -qN -w -- 'ODD' "$d" 2>/dev/null || rg -qNi -- 'organic[- ]driven' "$d" 2>/dev/null; then
    fail "$d names the borrowed method — the installed payload uses Libretto's own vocabulary"
  else ok "$d carries no borrowed method name"; fi
done
# Never a pipe into `rg -q` (or `--quiet`). Under `set -o pipefail` the reader stops at its
# first match, the writer before it dies of SIGPIPE, and the pipeline's 141 reads as "no
# match": it made spec-drift --retired fail open on a long change document. Read the input
# whole instead — `rg … >/dev/null`. Built from parts so this row's own source cannot match.
pipe_rg='(^|[^|])\|[[:space:]]*rg'
quiet_flag='([[:space:]]+[^|[:space:]]+)*[[:space:]]+(-[A-Za-z]*q[A-Za-z]*|--quiet)([[:space:]]|$)'
pipe_hits=$(rg -n -e "${pipe_rg}${quiet_flag}" skills scripts 2>/dev/null)
if [ -z "$pipe_hits" ]; then
  ok 'no pipe into rg -q in the payload scripts'
else
  while IFS= read -r h; do fail "a pipe into rg -q reads SIGPIPE as no match under pipefail — $h"; done <<< "$pipe_hits"
fi
# Claude Code substitutes a bare dollar-digit in a skill or command body with the words of
# the invocation's arguments, so shell or awk written that way runs on the user's request
# instead of its input. `${1}` and `$(0)` mean the same and are left alone.
argv_hits=$(rg -n -e '\$[0-9]' skills/*/SKILL.md commands/*.md 2>/dev/null)
if [ -z "$argv_hits" ]; then
  ok 'no bare dollar-digit in a skill or command body'
else
  while IFS= read -r h; do fail "a bare dollar-digit is replaced by the invocation's arguments — $h"; done <<< "$argv_hits"
fi
check_wiring skills/record-work/forge.md 'the label rides .gh pr create' 'a bump decided before the request rides gh pr create --label'
check_wiring skills/write-spec/SKILL.md 'a leading .!. excludes' 'write-spec names the Governs: exclusion'
# trim-skill-reading-cost: a skill body loads whole on every invocation, so guidance that
# applies only on a condition lives in a sibling file, named with its condition on one line.
check_wiring skills/record-work/SKILL.md 'When .*, read .drift\.md. beside this file' 'record-work names drift.md with its condition'
check_wiring skills/record-work/SKILL.md 'When .*, read .forge\.md. beside this file' 'record-work names forge.md with its condition'
check_absent skills/record-work/SKILL.md 'does three things together' 'the landing list is not introduced as three things'
# The ceilings sit below each body's size before the split, so the rows were red first.
for budget in record-work:300 find-work:300 write-spec:580; do
  f="skills/${budget%%:*}/SKILL.md"; n=$(wc -l < "$f" | tr -d ' ')
  if [ "$n" -le "${budget##*:}" ]; then ok "$f is $n lines, within ${budget##*:}"
  else fail "$f is $n lines, over its budget of ${budget##*:} — move conditional guidance to a sibling file"; fi
done
check_wiring skills/find-work/SKILL.md "^bash <<'SCAN'$" 'find-work runs its scan through bash, which zsh cannot abort on an empty glob'
check_wiring commands/libretto-status.md 'Skill\(skill="find-work"\)' 'status delegates the scan to find-work'
check_wiring commands/libretto-status.md 'proposal\.md..s .## Checklist.' 'status names proposal.md among the files the scan reads'

# One change document, one stop, one fresh reviewer. The session writes proposal.md
# inline; a writer survives only for an extra capability's spec-<capability>.md, and a
# reviewer that never had the conversation reads the whole document before the one stop.
check_wiring skills/write-spec/SKILL.md 'contract into .proposal\.md. itself' 'phase 2 writes the primary contract into proposal.md, inline'
check_wiring skills/write-spec/SKILL.md 'six pillars as level-2 headings' 'the six pillars are level-2 headings, where spec-drift reads sections'
check_absent skills/write-spec/SKILL.md 'brief\.md'                       'phase 2 writes no brief'
check_absent skills/write-spec/SKILL.md 'decisions\.md'                   'phase 2 writes no separate decision log'
check_wiring skills/write-spec/SKILL.md 'spec-<capability>\.md'           'an extra capability gets its own spec-<capability>.md beside proposal.md'
check_wiring skills/write-spec/SKILL.md 'context cannot hold'             'a fan-out writer is launched only when context cannot hold the research'
check_wiring skills/write-plan/SKILL.md '## Approach'                     'phase 5 writes ## Approach into the change document'
check_wiring skills/write-tasks/SKILL.md '## Checklist., the change document.s last section' 'the checklist is the change document'"'"'s last section'
check_wiring skills/write-tasks/SKILL.md 'The session owns the checklist' 'one writer: the session marks the boxes'
check_wiring skills/record-work/SKILL.md 'proposal\.md..s contract and each .spec-<capability>\.md.' 'phase 8 lands the change document and each extra spec'
check_wiring skills/record-work/SKILL.md 'old-layout change'              'phase 8 still lands a change in the old layout'
check_wiring agents/spec-writer.md       'proposal\.md'                    'the fan-out writer reads proposal.md by path'
check_absent agents/spec-writer.md       '\bbrief\b|decisions\.md'         'the fan-out writer names no brief and no decisions.md as an input'
check_wiring agents/spec-reviewer.md     '^tools: Read, Grep, Glob, Bash, Skill$' 'spec-reviewer declares exactly Read, Grep, Glob, Bash, Skill'
check_wiring agents/spec-reviewer.md     'Never edit anything'             'spec-reviewer never edits what it reviews'
check_wiring agents/spec-reviewer.md     'For each box under .## Checklist.' 'spec-reviewer reports per box what the document fails to answer'
check_wiring skills/review-spec/SKILL.md 'exactly one .spec-reviewer.'     'review-spec launches one fresh spec-reviewer'
check_wiring skills/review-spec/SKILL.md 'none of the conversation'        'the reviewer is given paths and none of the conversation'
