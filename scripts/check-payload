check_wiring commands/libretto-flow.md   'one stop on the contract lane'   'the flow states its gear as one stop, none on the trivial lane'
check_absent commands/libretto-flow.md   'two stops with a contract'       'the retired two-stop gear is gone'
check_wiring commands/libretto-attacca.md 'the one stop and the push'      'attacca names the one stop and the push as what it answered'

# The contract lane runs write-spec, write-plan, write-tasks, then review-spec: the
# reviewer reads the whole document, so it cannot run before the checklist exists.
if awk '
  /Skill\(skill="write-spec"\)/  && !a { a = NR }
  /Skill\(skill="write-plan"\)/  && !b { b = NR }
  /Skill\(skill="write-tasks"\)/ && !c { c = NR }
  /Skill\(skill="review-spec"\)/ && !d { d = NR }
  END { exit !(a && a < b && b < c && c < d) }
' commands/libretto-flow.md; then
  ok 'the flow routes write-spec, write-plan, write-tasks, then review-spec'
else
  fail 'commands/libretto-flow.md does not route write-spec → write-plan → write-tasks → review-spec in that order'
fi

# Neither retired writer is named or shipped. An agent that ships is named by the skill
# that launches it, so a name left behind is either a launch nobody can make or a file
# the linker installs for nothing.
retired_hits=$(rg -n 'plan-writer|task-cutter' skills agents commands 2>/dev/null || true)
for a in plan-writer task-cutter; do
  [ -e "agents/$a.md" ] && retired_hits="${retired_hits:+$retired_hits$'\n'}agents/$a.md exists"
done
if [ -z "$retired_hits" ]; then
  ok 'neither plan-writer nor task-cutter is named or shipped'
else
  while IFS= read -r h; do fail "a retired writer is still named or shipped: $h"; done <<< "$retired_hits"
fi

# spec-writer survives for one seat: write-spec's fan-out. Line-scoped rows cannot say
# "only inside that section", so this tracks it — the section opens on `## Step 2b` and
# closes on the next level-2 heading outside a fence, the boundary spec-drift reads too.
sw_hits=$(rg -l 'spec-writer' skills agents commands 2>/dev/null | while IFS= read -r f; do
  [ "$f" = agents/spec-writer.md ] && continue
  awk -v f="$f" -v ws="$([ "$f" = skills/write-spec/SKILL.md ] && echo 1)" '
    /^```/ { fence = !fence }
    ws && !fence && /^## / { fan = ($0 ~ /^## Step 2b/) }
    /spec-writer/ && !fan { print f ":" NR }
  ' "$f"
done)
if [ -z "$sw_hits" ]; then
  ok 'spec-writer is named only in write-spec'"'"'s fan-out section and its own file'
else
  while IFS= read -r h; do fail "spec-writer named outside write-spec's fan-out: $h"; done <<< "$sw_hits"
fi

# converge: a side door that re-derives a drifted checklist. One fresh reader judges, the
# session runs every proof it closes on, and nothing the reader says is evidence — so the
# reader is declared shell-less, and a Bash added later fails here rather than in a review.
check_wiring commands/libretto-converge.md 'Skill\(skill="converge"\)'   'libretto-converge routes to the converge skill'
check_wiring skills/converge/SKILL.md 'exactly one .converge-reader.'     'converge launches exactly one converge-reader'
